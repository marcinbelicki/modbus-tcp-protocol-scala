<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{"yyyy-MM-dd'T'HH:mm:ss.SSS"}] %-5level|%logger{0}|%X{remote} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.pekko.event.slf4j.Slf4jLogger" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
